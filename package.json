{
  "name": "haylen-site",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Static Haylen website and WebAssembly sample gallery",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "demos:build": "node scripts/build-web-demos.mjs",
    "playground:runtime": "node scripts/playground-runtime.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview": "wrangler pages dev dist",
    "deploy": "wrangler pages deploy dist",
    "test:browser": "playwright test --config playwright.config.mjs",
    "test:playground": "playwright test --config playwright.playground.config.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@lezer/highlight": "1.2.5",
    "@playwright/test": "1.65.1",
    "@tailwindcss/cli": "4.3.5",
    "codemirror": "6.0.2",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "lucide-static": "1.72.0",
    "prettier": "3.8.4",
    "tailwindcss": "4.3.5",
    "wrangler": "4.162.0"
  }
}
